# HERITIA backend — copy to .env

# --- App ---
HERITIA_ENVIRONMENT=development
HERITIA_APP_BASE_URL=https://heritia.neriacorp.com
HERITIA_FRONTEND_URL=http://localhost:5174
HERITIA_SECRET_KEY=change-me
HERITIA_DATABASE_URL=sqlite:///./heritia.db

# Comma-separated CORS origins (defaults include localhost + production)
# HERITIA_CORS_ORIGINS=http://localhost:5174,https://heritia.neriacorp.com

# --- N2 shared infrastructure (Master Key — one of these env names) ---
N2_MASTER_KEY=
# NERIA_MASTER_KEY=
# X_MASTER_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=heritia@neriacorp.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=heritia

# --- Firebase (cagnotte & achats ebooks synchronisés N2) ---
FIREBASE_PROJECT_ID=
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
HERITIA_STRIPE_SECRET_KEY=sk_test_xxx
HERITIA_STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Production / Railway (service heritia-api) + N2 Single Ingress ---
# HERITIA_ENVIRONMENT=production
# HERITIA_APP_BASE_URL=https://heritia.neriacorp.com
# HERITIA_FRONTEND_URL=https://heritia.neriacorp.com
# HERITIA_CORS_ORIGINS=https://heritia.neriacorp.com,http://localhost:5174
# API publique same-origin : https://heritia.neriacorp.com/api (proxifié par N2)
# N2_MASTER_KEY=<from NeriaCorp secret manager>
# RESEND_API_KEY=<from NeriaCorp secret manager>
# HERITIA_STRIPE_SECRET_KEY=sk_live_xxx
