# HERITIA frontend — copy to .env / .env.production

# Local (Vite proxy → backend :8001)
VITE_API_URL=/api
VITE_APP_URL=http://localhost:5174

# --- Production / Railway (service heritia-web, rootDirectory=frontend) ---
# Point VITE_API_URL to the backend public URL + /api
# VITE_API_URL=https://heritia-api.up.railway.app/api
# VITE_APP_URL=https://heritia.neriacorp.com