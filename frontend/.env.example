# HERITIA frontend — copy to .env / .env.production

# Local (Vite proxy → backend :8001)
VITE_API_URL=/api
VITE_APP_URL=http://localhost:5174

# --- Production (service heritia-web, rootDirectory=frontend) ---
# API served via reverse proxy on the same domain
# VITE_API_URL=https://heritia.neriacorp.com/api
# VITE_APP_URL=https://heritia.neriacorp.com
